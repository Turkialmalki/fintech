# ---- Required ----
JWT_SECRET=replace-with-64-random-characters
POSTGRES_PASSWORD=rip

# ---- AI provider: mock | qwen | llama | openai_compatible ----
AI_PROVIDER=mock
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1500

# Provider-specific endpoints (used for runtime switching in Settings → Model configuration)
# Qwen via self-hosted vLLM:   QWEN_BASE_URL=http://vllm-qwen:8000/v1   model e.g. Qwen/Qwen2.5-72B-Instruct
# Qwen via DashScope (intl):   QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  model e.g. qwen-plus
QWEN_BASE_URL=
QWEN_API_KEY=
# Llama via vLLM:              LLAMA_BASE_URL=http://vllm-llama:8000/v1  model e.g. meta-llama/Llama-3.3-70B-Instruct
LLAMA_BASE_URL=
LLAMA_API_KEY=

# ---- Embeddings: mock | openai_compatible (e.g. BGE-M3 via TEI/vLLM) ----
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=384

# ---- Security / ops ----
FILE_SCANNER=none
RATE_LIMIT_PER_MINUTE=240
DATA_RETENTION_DAYS=365
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
